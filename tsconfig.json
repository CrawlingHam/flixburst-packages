{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2020",
        "module": "NodeNext",
        "lib": ["ES2020"],
        "rootDir": "./src",

        /* Emit */
        "removeComments": false,
        "declarationMap": true,
        "declaration": true,
        "outDir": "./dist",
        "sourceMap": true,

        /* Type Checking */
        "strict": true,

        /* Interop Constraints */
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,

        /* Module Resolution */
        "moduleResolution": "NodeNext",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
