{
    "name": "flixburst-environment_variables",
    "version": "1.0.4",
    "description": "A flexible and extensible package for environment variables",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "typesVersions": {
        "*": {
            "*": [
                "./dist/types/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "pnpm clean && pnpm lint && pnpm format && pnpm build:all",
        "build:all": "pnpm build:types && pnpm build:cjs && pnpm build:esm",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "lint": "eslint --config eslint.config.mjs .",
        "format": "prettier --write \"src/**/*.ts\"",
        "build:types": "tsc -p tsconfig.types.json",
        "build:cjs": "tsc -p tsconfig.cjs.json",
        "build:esm": "tsc -p tsconfig.esm.json",
        "typecheck": "tsc --noEmit",
        "prepare": "pnpm build",
        "clean": "del-cli dist"
    },
    "keywords": [
        "typescript",
        "environment",
        "variables"
    ],
    "author": "Flixburst",
    "license": "MIT",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.29.1",
        "@typescript-eslint/parser": "^8.29.1",
        "eslint-config-prettier": "^10.1.1",
        "@eslint/eslintrc": "^3.3.1",
        "@types/node": "^20.17.30",
        "@eslint/js": "^9.24.0",
        "typescript": "^5.8.3",
        "prettier": "^3.5.3",
        "del-cli": "^6.0.0",
        "eslint": "^9.24.0"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    },
    "packageManager": "pnpm@10.7.1"
}
