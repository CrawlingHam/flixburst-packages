{
    "name": "flixburst-environment_variables",
    "version": "1.0.8",
    "description": "A flexible and extensible package for environment variables",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "pnpm clean && pnpm lint && pnpm format && tsup",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "lint": "eslint --config eslint.config.mjs .",
        "format": "prettier --write \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "prepare": "pnpm build",
        "clean": "del-cli dist"
    },
    "keywords": [
        "typescript",
        "environment",
        "variables"
    ],
    "author": "Flixburst",
    "license": "MIT",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.25.1",
        "@types/node": "^20.17.30",
        "@typescript-eslint/eslint-plugin": "^8.31.0",
        "@typescript-eslint/parser": "^8.31.0",
        "@typescript-eslint/typescript-estree": "^8.31.0",
        "del-cli": "^6.0.0",
        "eslint": "^9.25.1",
        "eslint-config-prettier": "^10.1.2",
        "prettier": "^3.5.3",
        "tsup": "^8.0.2",
        "typescript": "^5.8.3"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    },
    "packageManager": "pnpm@10.7.1"
}
